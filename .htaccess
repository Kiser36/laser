# Owere & Associates — Apache hardening
Options -Indexes

# Block direct access to SQL, markdown, YAML and JSON content files
<FilesMatch "\.(sql|md|yml|yaml|json|lock)$">
    Require all denied
</FilesMatch>

# Protect the config and content folders
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|content)/ - [F,L]

    # Serve the dynamic sitemap and robots.txt under their standard names
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$ robots.php [L]
</IfModule>

# Basic browser caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
